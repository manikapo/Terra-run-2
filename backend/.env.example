# Server
PORT=8080
ENV=development

# Supabase Postgres (Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Internal cron (GitHub Actions → POST /internal/jobs/decay)
INTERNAL_JOB_SECRET=generate-a-long-random-string

# Optional: R2 for route storage (Phase 1 can skip — routes stored in DB JSONB)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=territory-run
R2_PUBLIC_URL=https://cdn.yourdomain.com

# H3 resolution for capture (10 ≈ 66m hex edge)
H3_CAPTURE_RESOLUTION=10
H3_TILE_RESOLUTION=7

# Anti-cheat thresholds
MAX_SPEED_MPS=7.0
MAX_ACCURACY_METERS=40.0
MIN_ACTIVITY_DURATION_SEC=60

# Cells not defended for this many days become neutral
TERRITORY_DECAY_DAYS=14
